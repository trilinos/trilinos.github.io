      J [A \; b] &= [F \; f_p] \\
      J [C \; d] &= (Jv)_x[A \; b] - [G \; (Jv)_p] \\
      z &= (h + \phi^T C) / \phi^T d \\
      X &= A - b z \\
      Y &= -C + d z
   \end{split}
\]
